# Ключ API: https://platform.claude.com/settings/keys
# Для Telegram-бота можно оставить пустым: тогда бот работает через Claude Code
# на этом компьютере по вашей подписке Claude (нужен установленный Claude Code).
ANTHROPIC_API_KEY=
# Необязательно: другая модель (по умолчанию claude-opus-5)
# ASSISTANT_MODEL=claude-opus-5
# Необязательно: папка для заметок, задач и файлов (по умолчанию ./data)
# ASSISTANT_DATA_DIR=./data

# Бесплатная альтернатива: ключ Google Gemini с https://aistudio.google.com/apikey
# (используется, если ANTHROPIC_API_KEY пуст)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# --- Telegram-бот ---
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш Telegram ID (бот сообщит его в ответ на /start). Несколько — через запятую.
TELEGRAM_ALLOWED_USERS=
# Бесплатный голос озвучки (Edge TTS). Варианты: ru-RU-DmitryNeural (мужской, по умолчанию),
# ru-RU-SvetlanaNeural, uk-UA-PolinaNeural, uk-UA-OstapNeural
# TTS_VOICE=ru-RU-DmitryNeural

# ElevenLabs — более живой голос (https://elevenlabs.io → Profile → API Keys).
# Если ключ пуст или лимит закончился, бот сам переключится на бесплатный голос выше.
ELEVENLABS_API_KEY=
# ID голоса из библиотеки ElevenLabs (по умолчанию George — спокойный британский мужской)
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# eleven_multilingual_v2 — лучшее качество; eleven_flash_v2_5 — быстрее и экономнее
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Модель распознавания: base (быстрее) / small (точнее, по умолчанию) / medium
# WHISPER_MODEL=small

# --- Джарвис ---
# Обращение к вам: сэр / мэм / по имени
# USER_TITLE=сэр
# Голос Джарвиса: ru-RU-DmitryNeural, uk-UA-OstapNeural и др.
# JARVIS_VOICE=ru-RU-DmitryNeural
# JARVIS_PORT=8765
